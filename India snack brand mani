<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Desi Tadka - Indian Snacks</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">

    <style>
        /* =========================
           RESET
        ========================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: #ffffff;
            color: #111111;
            font-family: "DM Sans", sans-serif;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: inherit;
        }

        :root {
            --orange: #ff6800;
            --orange-dark: #e95700;
            --purple: #a87bd4;
            --purple-light: #cbb1e9;
            --black: #111111;
        }

        .container {
            width: min(1160px, calc(100% - 80px));
            margin: auto;
        }


        /* =========================
           HEADER
        ========================== */

        .site-header {
            width: 100%;
            height: 96px;
            background: #ffffff;
            position: relative;
            z-index: 20;
        }

        .header-container {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }


        /* LOGO */

        .brand-logo {
            width: 150px;
            display: flex;
            flex-direction: column;
            line-height: 0.82;
        }

        .logo-desi {
            color: var(--orange);
            font-family: "Playfair Display", serif;
            font-size: 32px;
            font-weight: 800;
            font-style: italic;
        }

        .logo-tadka {
            color: var(--black);
            font-family: "Playfair Display", serif;
            font-size: 34px;
            font-weight: 800;
            font-style: italic;
        }

        .brand-logo small {
            margin-top: 8px;
            color: #111111;
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 2px;
        }


        /* NAVIGATION */

        .main-nav {
            height: 100%;
            display: flex;
            align-items: center;
            gap: 38px;
            margin-left: auto;
            margin-right: 36px;
        }

        .main-nav a {
            position: relative;
            color: #191919;
            font-size: 14px;
            font-weight: 600;
            white-space: nowrap;
            transition: 0.2s;
        }

        .main-nav a:hover,
        .main-nav a.active {
            color: var(--orange);
        }

        .main-nav a.active::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: -14px;
            height: 2px;
            background: var(--orange);
        }

        .products-link {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .arrow {
            font-size: 16px;
        }


        /* HEADER ACTIONS */

        .header-actions {
            display: flex;
            align-items: center;
            gap: 17px;
        }

        .icon-button,
        .cart-button {
            width: 32px;
            height: 38px;
            border: 0;
            background: transparent;
            cursor: pointer;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .search-icon {
            width: 17px;
            height: 17px;
            border: 2px solid #111111;
            border-radius: 50%;
            position: relative;
        }

        .search-icon::after {
            content: "";
            width: 7px;
            height: 2px;
            background: #111111;
            position: absolute;
            right: -5px;
            bottom: -2px;
            transform: rotate(48deg);
            border-radius: 2px;
        }

        .cart-icon {
            font-size: 19px;
            filter: grayscale(1);
        }

        .cart-count {
            position: absolute;
            top: 0;
            right: -2px;
            min-width: 15px;
            height: 15px;
            padding: 0 3px;
            border-radius: 50%;
            background: var(--orange);
            color: white;
            font-size: 9px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .header-shop-button {
            background: var(--orange);
            color: #ffffff;
            padding: 13px 23px;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 700;
            transition: 0.2s;
        }

        .header-shop-button:hover {
            background: var(--orange-dark);
            transform: translateY(-1px);
        }


        /* =========================
           HERO SECTION
        ========================== */

        .hero-section {
            position: relative;
            overflow: hidden;
            background: #ffffff;
            min-height: 545px;
        }

        .hero-container {
            min-height: 545px;
            display: grid;
            grid-template-columns: 42% 58%;
            align-items: center;
        }


        /* HERO TEXT */

        .hero-content {
            position: relative;
            z-index: 5;
            padding-top: 8px;
        }

        .hero-content h1 {
            max-width: 500px;
            color: var(--black);
            font-family: "Playfair Display", serif;
            font-size: clamp(48px, 4.3vw, 65px);
            line-height: 1.04;
            font-weight: 700;
            letter-spacing: -2px;
        }

        .hero-content h1 span {
            color: var(--orange);
        }

        .hero-decoration {
            width: 95px;
            margin: 17px 0 20px;
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .hero-decoration span {
            width: 58px;
            height: 2px;
            background: var(--orange);
        }

        .hero-decoration b {
            color: var(--orange);
            font-size: 18px;
        }

        .hero-description {
            color: #282828;
            font-size: 15px;
            line-height: 1.65;
            margin-bottom: 26px;
        }


        /* BUTTONS */

        .hero-buttons {
            display: flex;
            align-items: center;
            gap: 13px;
            margin-bottom: 45px;
        }

        .primary-button,
        .secondary-button {
            min-width: 110px;
            height: 45px;
            padding: 0 20px;
            border-radius: 24px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
            transition: 0.2s;
        }

        .primary-button {
            color: white;
            background: var(--orange);
            border: 1.5px solid var(--orange);
        }

        .primary-button:hover {
            background: var(--orange-dark);
        }

        .secondary-button {
            color: var(--purple);
            background: white;
            border: 1.5px solid var(--purple);
        }

        .secondary-button:hover {
            color: white;
            background: var(--purple);
        }


        /* =========================
           HERO FEATURES
        ========================== */

        .hero-features {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .hero-feature {
            min-height: 43px;
            display: flex;
            align-items: center;
            gap: 8px;
            padding-right: 17px;
            border-right: 1px solid #dedede;
        }

        .hero-feature:last-child {
            border-right: none;
            padding-right: 0;
        }

        .feature-icon {
            width: 28px;
            height: 28px;
            border: 1.5px solid var(--purple);
            color: var(--purple);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            font-weight: 600;
        }

        .hero-feature strong,
        .hero-feature span {
            display: block;
            color: #222222;
            font-size: 10px;
            line-height: 1.4;
        }

        .hero-feature strong {
            font-weight: 700;
        }

        .hero-feature span {
            font-weight: 500;
        }


        /* =========================
           HERO IMAGE
        ========================== */

        .hero-visual {
            height: 100%;
            min-height: 545px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .hero-image {
            position: relative;
            z-index: 3;
            width: 730px;
            max-width: none;
            margin-left: -45px;
            object-fit: contain;
        }


        /* PURPLE DECORATION */

        .purple-decoration {
            position: absolute;
            background: var(--purple-light);
            opacity: 0.35;
            z-index: 1;
        }

        .purple-left {
            width: 145px;
            height: 145px;
            border-radius: 50%;
            left: -105px;
            top: 205px;
        }

        .purple-right {
            width: 190px;
            height: 190px;
            border-radius: 50%;
            right: -130px;
            bottom: 35px;
        }


        /* ORANGE DOTS */

        .orange-dots {
            position: absolute;
            z-index: 2;
            color: var(--orange);
            letter-spacing: 6px;
            font-size: 15px;
        }

        .dots-top {
            top: 75px;
            right: 5px;
        }

        .dots-bottom {
            bottom: 80px;
            left: 10px;
        }


        /* =========================
           TABLET
        ========================== */

        @media (max-width: 1100px) {

            .main-nav {
                gap: 20px;
                margin-right: 15px;
            }

            .hero-container {
                grid-template-columns: 43% 57%;
            }

            .hero-content h1 {
                font-size: 48px;
            }

            .hero-features {
                gap: 12px;
            }

            .hero-feature {
                padding-right: 10px;
            }

            .hero-image {
                width: 650px;
                margin-left: -60px;
            }
        }


        /* =========================
           MOBILE / TABLET
        ========================== */

        @media (max-width: 900px) {

            .site-header {
                height: auto;
                padding: 18px 0;
            }

            .header-container {
                flex-wrap: wrap;
                gap: 18px;
            }

            .main-nav {
                order: 3;
                width: 100%;
                justify-content: center;
                margin: 0;
                gap: 22px;
                overflow-x: auto;
                padding-bottom: 4px;
            }

            .main-nav a.active::after {
                bottom: -7px;
            }

            .hero-container {
                grid-template-columns: 1fr;
                padding-top: 45px;
                padding-bottom: 30px;
            }

            .hero-content {
                text-align: center;
            }

            .hero-content h1 {
                margin: auto;
            }

            .hero-decoration {
                margin-left: auto;
                margin-right: auto;
            }

            .hero-description {
                margin-left: auto;
                margin-right: auto;
            }

            .hero-buttons {
                justify-content: center;
            }

            .hero-features {
                justify-content: center;
                flex-wrap: wrap;
            }

            .hero-visual {
                min-height: 390px;
            }

            .hero-image {
                width: min(700px, 100vw);
                margin-left: 0;
            }
        }


        /* =========================
           MOBILE
        ========================== */

        @media (max-width: 600px) {

            .container {
                width: calc(100% - 30px);
            }

            .brand-logo {
                width: 125px;
            }

            .logo-desi {
                font-size: 26px;
            }

            .logo-tadka {
                font-size: 28px;
            }

            .header-actions {
                gap: 7px;
            }

            .header-shop-button {
                padding: 10px 14px;
                font-size: 11px;
            }

            .main-nav {
                justify-content: flex-start;
                gap: 25px;
                font-size: 12px;
            }

            .hero-content h1 {
                font-size: 43px;
                letter-spacing: -1px;
            }

            .hero-description {
                font-size: 13px;
            }

            .hero-features {
                gap: 12px;
            }

            .hero-feature {
                border-right: none;
                padding-right: 0;
            }

            .hero-visual {
                min-height: 280px;
            }

            .hero-image {
                width: 125%;
                max-width: none;
                margin-left: -12%;
            }
        }
    </style>
</head>

<body>

    <!-- =========================
         HEADER
    ========================== -->

    <header class="site-header">

        <div class="container header-container">

            <!-- Logo -->
            <a href="#" class="brand-logo">
                <span class="logo-desi">Desi</span>
                <span class="logo-tadka">Tadka</span>
                <small>INDIAN SNACKS</small>
            </a>


            <!-- Navigation -->
            <nav class="main-nav">

                <a href="#" class="active">Home</a>

                <a href="#">About Us</a>

                <a href="#" class="products-link">
                    Products
                    <span class="arrow">⌄</span>
                </a>

                <a href="#">Our Story</a>

                <a href="#">Blog</a>

                <a href="#">Contact Us</a>

            </nav>


            <!-- Header Buttons -->
            <div class="header-actions">

                <button class="icon-button" aria-label="Search">
                    <span class="search-icon"></span>
                </button>

                <button class="cart-button" aria-label="Shopping Cart">
                    <span class="cart-icon">🛒</span>
                    <span class="cart-count">0</span>
                </button>

                <a href="#" class="header-shop-button">
                    Shop Now
                </a>

            </div>

        </div>

    </header>


    <!-- =========================
         HERO SECTION
    ========================== -->

    <main>

        <section class="hero-section">

            <div class="hero-container container">


                <!-- LEFT SIDE -->
                <div class="hero-content">

                    <h1>
                        Crispy Bites,
                        <span>Desi</span> Delights!
                    </h1>


                    <div class="hero-decoration">
                        <span></span>
                        <b>✦</b>
                    </div>


                    <p class="hero-description">
                        Tasty, crunchy &amp; made for every moment.<br>
                        Your favourite Indian snacks at<br>
                        prices you'll love.
                    </p>


                    <div class="hero-buttons">

                        <a href="#" class="primary-button">
                            Shop Now
                        </a>

                        <a href="#" class="secondary-button">
                            View All Products
                        </a>

                    </div>


                    <!-- Features -->
                    <div class="hero-features">

                        <div class="hero-feature">

                            <div class="feature-icon">
                                ♧
                            </div>

                            <div>
                                <strong>100% Veg</strong>
                            </div>

                        </div>


                        <div class="hero-feature">

                            <div class="feature-icon">
                                ♢
                            </div>

                            <div>
                                <strong>Hygienically</strong>
                                <span>Packed</span>
                            </div>

                        </div>


                        <div class="hero-feature">

                            <div class="feature-icon">
                                ₹
                            </div>

                            <div>
                                <strong>Great Taste</strong>
                                <span>Low Price</span>
                            </div>

                        </div>


                        <div class="hero-feature">

                            <div class="feature-icon">
                                ♡
                            </div>

                            <div>
                                <strong>Loved by</strong>
                                <span>Thousands</span>
                            </div>

                        </div>

                    </div>

                </div>


                <!-- RIGHT SIDE -->
                <div class="hero-visual">

                    <div class="purple-decoration purple-left"></div>

                    <div class="purple-decoration purple-right"></div>


                    <!-- IMPORTANT:
                         Put your snack image here:
                         images/hero-snacks.png
                    -->

                    <img
                        src="images/hero-snacks.png"
                        alt="Desi Tadka Indian snacks"
                        class="hero-image"
                    >


                    <div class="orange-dots dots-top">
                        • • •
                    </div>

                    <div class="orange-dots dots-bottom">
                        • • •
                    </div>

                </div>

            </div>

        </section>

    </main>

</body>
</html>
