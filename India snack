<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Desi Tadka | Authentic Indian Snacks</title>
    <!-- Google Fonts for crisp typography match -->
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        /* ==========================================================================
           1. CSS VARIABLES & CORE DESIGN TOKENS
           ========================================================================== */
        :root {
            --brand-red: #E1251B;
            --brand-red-hover: #C51B12;
            --brand-green: #1E5E2F;
            --brand-gold: #FFB700;
            --text-main: #1A1A1A;
            --text-light: #666666;
            --bg-light: #FAFAFA;
            --bg-hero: #F9FDF9;
            --white: #FFFFFF;
            --footer-bg: #0B1910;
            --max-width: 1200px;
            --shadow-sm: 0 2px 8px rgba(0,0,0,0.06);
            --shadow-md: 0 4px 15px rgba(0,0,0,0.08);
        }

        /* ==========================================================================
           2. GLOBAL RESETS
           ========================================================================== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: var(--white);
            color: var(--text-main);
            overflow-x: hidden;
            line-height: 1.5;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        ul {
            list-style: none;
        }

        img {
            max-width: 100%;
            height: auto;
            display: block;
        }

        /* Global Structural Divider */
        hr {
            border: none;
            border-top: 1px solid #EEEEEE;
            max-width: var(--max-width);
            margin: 0 auto;
        }

        /* ==========================================================================
           3. SITE HEADER NAVIGATION BAR
           ========================================================================== */
        .site-header {
            background-color: var(--white);
            border-bottom: 1px solid #EEEEEE;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .nav-container {
            max-width: var(--max-width);
            margin: 0 auto;
            padding: 0.8rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand-logo {
            display: flex;
            flex-direction: column;
        }

        .logo-main {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--brand-red);
            font-style: italic;
            line-height: 1;
        }

        .logo-sub {
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 2px;
            color: var(--brand-green);
            text-transform: uppercase;
            margin-top: 2px;
        }

        .nav-menu {
            display: flex;
            gap: 1.8rem;
        }

        .nav-link {
            font-size: 0.9rem;
            font-weight: 500;
            transition: color 0.2s ease;
        }

        .nav-link:hover, .nav-link.active {
            color: var(--brand-red);
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 1.2rem;
        }

        .icon-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 1.1rem;
            color: var(--text-main);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .cart-badge {
            position: absolute;
            top: -6px;
            right: -8px;
            background-color: var(--brand-red);
            color: var(--white);
            font-size: 0.65rem;
            font-weight: 700;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-shop-top {
            background-color: var(--brand-red);
            color: var(--white);
            font-size: 0.85rem;
            font-weight: 600;
            padding: 0.5rem 1.2rem;
            border-radius: 20px;
            transition: background-color 0.2s ease;
        }

        .btn-shop-top:hover {
            background-color: var(--brand-red-hover);
        }

        /* ==========================================================================
           4. HERO MARKETING CONTAINER
           ========================================================================== */
        .hero-section {
            background-color: var(--bg-hero);
            padding: 4rem 2rem;
            overflow: hidden;
        }

        .hero-container {
            max-width: var(--max-width);
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1.1fr;
            gap: 2rem;
            align-items: center;
        }

        .hero-title {
            font-size: 3rem;
            font-weight: 800;
            line-height: 1.15;
            margin-bottom: 1.2rem;
            color: #0A2213;
        }

        .hero-title span {
            color: var(--brand-red);
        }

        .hero-desc {
            font-size: 1rem;
            color: var(--text-light);
            line-height: 1.5;
            margin-bottom: 2rem;
        }

        .hero-cta-group {
            display: flex;
            gap: 1rem;
            margin-bottom: 2.5rem;
        }

        .btn-prime {
            background-color: var(--brand-red);
            color: var(--white);
            font-size: 0.95rem;
            font-weight: 600;
            padding: 0.8rem 1.8rem;
            border-radius: 25px;
            transition: background-color 0.2s;
        }

        .btn-prime:hover {
            background-color: var(--brand-red-hover);
        }

        .btn-sec {
            background-color: transparent;
            color: var(--brand-red);
            border: 2px solid var(--brand-red);
            font-size: 0.95rem;
            font-weight: 600;
            padding: 0.8rem 1.8rem;
            border-radius: 25px;
            transition: all 0.2s;
        }

        .btn-sec:hover {
            background-color: var(--brand-red);
            color: var(--white);
        }

        .trust-badges {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem 1.5rem;
        }

        .badge-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.8rem;
            font-weight: 600;
            color: #2E4035;
        }

        .badge-icon {
            font-size: 1.1rem;
        }

        .hero-showcase {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0.8rem;
            align-items: end;
            padding-left: 1rem;
        }

        .product-pack-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .price-tag-bubble {
            background-color: var(--white);
            color: var(--text-main);
            font-size: 0.75rem;
            font-weight: 700;
            padding: 0.15rem 0.5rem;
            border-radius: 10px;
            box-shadow: var(--shadow-sm);
            margin-bottom: 0.4rem;
            border: 1px solid #EEEEEE;
        }

        .pack-mockup {
            width: 100%;
            height: 220px;
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 1rem 0.5rem;
            color: var(--white);
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        }

        .pack-mockup .brand {
            font-size: 0.5rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .pack-mockup .title {
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            line-height: 1.1;
            margin-top: auto;
        }

        .pack-moong { background: linear-gradient(135deg, #4CAF50 0%, #2E7D32 100%); }
        .pack-sev { background: linear-gradient(135deg, #FF5722 0%, #E64A19 100%); }
        .pack-meetha { background: linear-gradient(135deg, #FFC107 0%, #FFA000 100%); color: #1A1A1A !important; }
        .pack-navratan { background: linear-gradient(135deg, #673AB7 0%, #512DA8 100%); }

        .dish-plate-shadow {
            width: 75px;
            height: 18px;
            background: radial-gradient(ellipse at center, rgba(218,165,32,0.3) 0%, rgba(0,0,0,0) 70%);
            margin-top: 0.5rem;
            border-radius: 50%;
        }

        /* ==========================================================================
           5. SECTION HEADER COMMON COMPONENT
           ========================================================================== */
        .section-header {
            text-align: center;
            margin-bottom: 2.5rem;
        }

        .section-header h2 {
            font-size: 2rem;
            font-weight: 800;
            color: var(--text-main);
            position: relative;
            display: inline-block;
